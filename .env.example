# ── WhatsApp / Meta ────────────────────────────────────────────────────────────
# From Meta App Dashboard → WhatsApp → API Setup
META_APP_SECRET=                   # App Secret (used to verify X-Hub-Signature-256)
WHATSAPP_VERIFY_TOKEN=             # Any secret string you choose for webhook verification
WHATSAPP_PHONE_NUMBER_ID=          # Phone Number ID
WHATSAPP_BUSINESS_ACCOUNT_ID=      # WhatsApp Business Account ID
WHATSAPP_ACCESS_TOKEN=             # Permanent System User token

# ── Clerk (Auth & Multi-tenancy) ───────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=              # For Clerk → our webhook (org/user sync)

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Google OAuth (Calendar) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# ── Database (Neon Postgres) ───────────────────────────────────────────────────
DATABASE_URL=                      # postgres://user:pass@host/db?sslmode=require

# ── Inngest ────────────────────────────────────────────────────────────────────
INNGEST_DEV=1                      # Set to 1 for local dev (disables signing key requirement)
INNGEST_EVENT_KEY=                 # From Inngest dashboard
INNGEST_SIGNING_KEY=               # From Inngest dashboard (not needed when INNGEST_DEV=1)

# ── Encryption ─────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=                    # 32-byte hex string for AES-GCM token encryption
                                   # Generate: openssl rand -hex 32
