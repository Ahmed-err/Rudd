{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "*.ts",
    "../shared/**/*.ts"
  ],
  "exclude": [
    "../shared/**/*.test.ts",
    "node_modules",
    "migrations"
  ]
}
