# Copy to apps/web/.env.local. In production, the app refuses to start if a required value is missing.

# ── WhatsApp / Meta (required) ─────────────────────────────────────────────────
META_APP_SECRET=                        # App Secret — verifies X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=                  # Any secret string; enter the same value in Meta's webhook settings
# Per-business WhatsApp credentials are entered in Dashboard → Settings → Integrations.

# ── Clerk (required) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=      # pk_... — without it, production returns 503 instead of running unauthenticated
CLERK_SECRET_KEY=                       # sk_...
CLERK_WEBHOOK_SECRET=                   # whsec_... from Clerk → Webhooks (only the Clerk webhook route needs it)

# ── AI (required: set one key) ─────────────────────────────────────────────────
GROQ_API_KEY=                           # console.groq.com — preferred when set
# GROQ_MODEL=openai/gpt-oss-120b        # optional override
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# OPENAI_API_KEY=                       # used only when GROQ_API_KEY is unset

# ── Google OAuth (required) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# ── Database (required) ────────────────────────────────────────────────────────
DATABASE_URL=                           # postgresql://...?sslmode=require from Neon

# ── Inngest ────────────────────────────────────────────────────────────────────
INNGEST_DEV=1                           # local dev only: use the Inngest Dev Server
INNGEST_EVENT_KEY=                      # required in production
INNGEST_SIGNING_KEY=                    # required in production

# ── Encryption (required) ──────────────────────────────────────────────────────
ENCRYPTION_KEY=                         # 64-char hex: openssl rand -hex 32

# ── Notifications (optional) ───────────────────────────────────────────────────
RESEND_API_KEY=                         # enables escalation emails
RESEND_FROM_EMAIL=                      # e.g. "Rudd <alerts@yourdomain.com>" — domain must be verified in Resend
NEXT_PUBLIC_APP_URL=                    # e.g. https://your-app.vercel.app (used in email links)

# ── LeadHunter outbound API (optional) ─────────────────────────────────────────
LEADHUNTER_API_KEY=                     # ≥32 chars; sent as "Authorization: Bearer <key>"
LEADHUNTER_TENANT_ID=                   # UUID of the tenant whose WhatsApp number sends lead messages

# ── Error monitoring (optional) ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                      # source map uploads only

# ── Seed script only (pnpm --filter @rudd/db seed) ─────────────────────────────
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=
