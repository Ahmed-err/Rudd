# ── WhatsApp / Meta ────────────────────────────────────────────────────────────
META_APP_SECRET=                        # App Secret from Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=                  # Any secret string for webhook verification

# ── Clerk ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=      # pk_live_... from Clerk production instance
CLERK_SECRET_KEY=                       # sk_live_... from Clerk production instance
CLERK_WEBHOOK_SECRET=                   # whsec_... from Clerk → Webhooks dashboard

# ── AI (pick one) ──────────────────────────────────────────────────────────────
GROQ_API_KEY=                           # From console.groq.com
# OPENAI_API_KEY=                       # OR OpenAI key

# ── Google OAuth (Calendar) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/oauth/google/callback

# ── Database (Neon Postgres) ───────────────────────────────────────────────────
DATABASE_URL=                           # postgresql://... from Neon dashboard

# ── Inngest ────────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=                      # From Inngest cloud dashboard
INNGEST_SIGNING_KEY=                    # From Inngest cloud dashboard

# ── Encryption ─────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=                         # 64-char hex: openssl rand -hex 32
